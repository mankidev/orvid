<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <TextView
        android:id="@+id/seek_hint_left"
        style="@style/SeekHint"
        android:layout_gravity="start|center_vertical"
        android:layout_marginStart="40dp"
        android:text="@string/seek_back" />

    <TextView
        android:id="@+id/seek_hint_right"
        style="@style/SeekHint"
        android:layout_gravity="end|center_vertical"
        android:layout_marginEnd="40dp"
        android:text="@string/seek_forward" />

    <FrameLayout
        android:id="@+id/overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0"
        android:background="#40000000"
        android:visibility="gone">

        <ImageButton
            android:id="@+id/ctl_close"
            style="@style/PlayerIcon"
            android:layout_gravity="top|start"
            android:contentDescription="@string/back"
            android:src="@drawable/ic_chevron_down_white" />

        <TextView
            android:id="@+id/ctl_title"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_gravity="top"
            android:layout_marginStart="48dp"
            android:layout_marginEnd="144dp"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:shadowColor="#99000000"
            android:shadowRadius="3"
            android:singleLine="true"
            android:textColor="#FFFFFFFF"
            android:textSize="15sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|end"
            android:layout_marginEnd="48dp"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/ctl_cast"
                style="@style/PlayerIcon"
                android:contentDescription="@string/cast"
                android:src="@drawable/ic_cast_white" />

            <ImageButton
                android:id="@+id/ctl_download"
                style="@style/PlayerIcon"
                android:contentDescription="@string/download"
                android:src="@drawable/ic_download_white"
                android:visibility="gone" />

            <ImageButton
                android:id="@+id/ctl_cc"
                style="@style/PlayerIcon"
                android:contentDescription="@string/subtitles"
                android:src="@drawable/ic_cc_white"
                android:visibility="gone" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/ctl_settings"
            style="@style/PlayerIcon"
            android:layout_gravity="top|end"
            android:contentDescription="@string/settings"
            android:src="@drawable/ic_settings_white" />

        <ImageButton
            android:id="@+id/ctl_play"
            android:layout_width="76dp"
            android:layout_height="76dp"
            android:layout_gravity="center"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/play"
            android:padding="10dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_pause_white" />

        <ImageButton
            android:id="@+id/ctl_previous"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_gravity="center"
            android:layout_marginEnd="96dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/previous_video"
            android:padding="10dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_skip_previous_white"
            android:visibility="invisible" />

        <ImageButton
            android:id="@+id/ctl_next"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_gravity="center"
            android:layout_marginStart="96dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/next_video"
            android:padding="10dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_skip_next_white"
            android:visibility="invisible" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingBottom="18dp">

            <TextView
                android:id="@+id/ctl_time"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFeatureSettings="tnum"
                android:shadowColor="#99000000"
                android:shadowRadius="3"
                android:textColor="#FFFFFFFF"
                android:textSize="12sp" />

            <ImageButton
                android:id="@+id/ctl_fullscreen"
                style="@style/PlayerIcon"
                android:contentDescription="@string/fullscreen"
                android:src="@drawable/ic_fullscreen_white" />
        </LinearLayout>

        <ImageView
            android:id="@+id/seek_preview"
            android:layout_width="160dp"
            android:layout_height="90dp"
            android:layout_gravity="bottom|start"
            android:layout_marginBottom="64dp"
            android:background="@drawable/bg_preview"
            android:padding="1dp"
            android:scaleType="centerCrop"
            android:visibility="gone" />

        <SeekBar
            android:id="@+id/ctl_seek"
            android:layout_width="match_parent"
            android:layout_height="24dp"
            android:layout_gravity="bottom"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:progressDrawable="@drawable/seek_track"
            android:progressBackgroundTint="#66FFFFFF"
            android:progressTint="#FFFFFFFF"
            android:secondaryProgressTint="#99FFFFFF"
            android:thumbTint="#FFFFFFFF" />
    </FrameLayout>

    <ProgressBar
        android:id="@+id/ctl_mini"
        style="@android:style/Widget.Material.ProgressBar.Horizontal"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:minHeight="1dp"
        android:maxHeight="1dp"
        android:progressDrawable="@drawable/mini_track"
        android:layout_gravity="bottom"
        android:max="1000"
        android:progressBackgroundTint="#40FFFFFF"
        android:progressTint="#FFFFFFFF"
        android:secondaryProgressTint="#80FFFFFF" />
</FrameLayout>
